VendorPayment _$VendorPaymentFromJson(Map<String, dynamic> json) =>
    VendorPayment(
      id: (json['id'] as num?)?.toInt(),
      invoiceId: (json['invoiceId'] as num).toInt(),
      paymentDate: DateTime.parse(json['paymentDate'] as String),
      amountPaid: (json['amountPaid'] as num).toDouble(),
      tdsDeducted: (json['tdsDeducted'] as num?)?.toDouble(),
      otherDeductions: (json['otherDeductions'] as num?)?.toDouble(),
      netPaid: (json['netPaid'] as num).toDouble(),
      paymentMode: json['paymentMode'] as String,
      transactionReference: json['transactionReference'] as String?,
      chequeNumber: json['chequeNumber'] as String?,
      bankName: json['bankName'] as String?,
      notes: json['notes'] as String?,
      createdAt: json['createdAt'] == null
          ? null
          : DateTime.parse(json['createdAt'] as String),
    );

Map<String, dynamic> _$VendorPaymentToJson(VendorPayment instance) =>
    <String, dynamic>{
      'id': instance.id,
      'invoiceId': instance.invoiceId,
      'paymentDate': instance.paymentDate.toIso8601String(),
      'amountPaid': instance.amountPaid,
      'tdsDeducted': instance.tdsDeducted,
      'otherDeductions': instance.otherDeductions,
      'netPaid': instance.netPaid,
      'paymentMode': instance.paymentMode,
      'transactionReference': instance.transactionReference,
      'chequeNumber': instance.chequeNumber,
      'bankName': instance.bankName,
      'notes': instance.notes,
      'createdAt': instance.createdAt?.toIso8601String(),
    };

